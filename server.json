{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Subcue/edititall-mcp",
  "description": "Drive EditItAll's local in-browser editors: PDF, sheet, photo, vector, Word, slides.",
  "repository": {
    "url": "https://github.com/Subcue/edititall-mcp",
    "source": "github"
  },
  "version": "0.2.1",
  "websiteUrl": "https://edititall.com/ai",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@edititall/mcp",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EDITITALL_URL",
          "description": "Editor origin (default https://edititall.com)",
          "isRequired": false
        },
        {
          "name": "CHROME_PATH",
          "description": "Chrome/Edge/Chromium binary if auto-detect fails",
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/Subcue/edititall-mcp/releases/download/v0.2.0/edititall-mcp.mcpb",
      "version": "0.2.0",
      "fileSha256": "ebeca971cff7dc4bb5eb548565c2ebb4f5532bc65621737af99a7c13f9655b85",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EDITITALL_URL",
          "description": "Editor origin (default https://edititall.com)",
          "isRequired": false
        },
        {
          "name": "CHROME_PATH",
          "description": "Chrome/Edge/Chromium binary if auto-detect fails",
          "isRequired": false
        }
      ]
    }
  ]
}
